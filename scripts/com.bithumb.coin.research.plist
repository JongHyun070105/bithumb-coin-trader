<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.bithumb.coin.research</string>
    <key>ProgramArguments</key>
    <array>
        <string>__PROJECT_DIR__/scripts/run_weekly_research_macos.sh</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key><integer>1</integer>
        <key>Hour</key><integer>3</integer>
        <key>Minute</key><integer>15</integer>
    </dict>
    <key>ProcessType</key><string>Background</string>
    <key>StandardOutPath</key><string>__PROJECT_DIR__/state/research.log</string>
    <key>StandardErrorPath</key><string>__PROJECT_DIR__/state/research_error.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>BITHUMB_NEW_ENTRIES</key><string>false</string>
    </dict>
</dict>
</plist>
