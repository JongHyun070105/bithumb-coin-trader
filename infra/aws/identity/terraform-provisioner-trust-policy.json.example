{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowNamedMfaUserToAssume",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${ACCOUNT_ID}:user/ParkJongHyun"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
