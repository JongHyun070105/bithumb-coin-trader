{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AssumeExactProvisionerRoleWithMfaOnly",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:aws:iam::${ACCOUNT_ID}:role/bitcoin-trader-terraform-provisioner",
      "Condition": {
        "Bool": {
          "aws:MultiFactorAuthPresent": "true"
        }
      }
    }
  ]
}
