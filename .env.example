# Never commit real API keys or Discord channel IDs.
BITHUMB_ACCESS_KEY=
BITHUMB_SECRET_KEY=
BITHUMB_DISCORD_TARGET=discord:<channel_id>

# Optional, reference-only crypto headlines. Never paste the key into chat or commit it.
BITHUMB_FINNHUB_API_KEY=

# Live trading remains disabled unless all code-level gates are also satisfied.
TRADING_MODE=paper
BITHUMB_LIVE_TRADING=false

# Optional allowlist of manually managed coins to exclude from bot reconciliation (e.g. BTC,ETH)
MANUAL_HOLDINGS_ALLOWLIST=
